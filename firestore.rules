// Reglas de seguridad de Firestore — Fiscalito (G-03).
//
// ESTE ARCHIVO NO ESTÁ DESPLEGADO. Es una propuesta versionada.
// ---------------------------------------------------------------------------
// Desplegarlo es acción de Ricardo, y hay que hacerlo con cuidado:
//
//   1. `apps/store/firebase.json` tiene bloque `hosting` y **NO** tiene bloque
//      `firestore`. Por eso hoy `firebase deploy` publica sólo el sitio. Si se
//      le agrega el bloque `firestore`, ese mismo comando pasa a publicar
//      también estas reglas — y si son más estrechas que las que están vivas en
//      la consola, el próximo deploy del front rompe producción sin avisar.
//      **Por eso `firebase.json` se dejó intacto**: quien despliegue esto tiene
//      que hacerlo a propósito, con `firebase deploy --only firestore:rules`.
//   2. Antes de desplegar, compara con las reglas vivas en la consola. Nadie en
//      este repo las ha leído: no estaban versionadas.
//
// LO QUE PROTEGEN Y POR QUÉ IMPORTA MÁS QUE ANTES
// ---------------------------------------------------------------------------
// Hasta G-01, `users/{uid}` guardaba datos del propio titular (RFC, régimen).
// Ahora guarda, bajo `clientes/{id}/empleados/{id}`, **el salario y —cuando se
// capture— el NSS de terceros**: los trabajadores de los clientes del despacho.
// Es una escalada real de sensibilidad y no debería quedarse bajo unas reglas
// que nadie ha revisado.
//
// EL CRITERIO DE G-03 DEPENDE DE ESTO
// ---------------------------------------------------------------------------
// "Dos cuentas distintas ven carteras distintas" se cumple gracias a estas
// reglas. Sin ellas desplegadas, la app cae al catálogo del backend —para que
// la demo no se rompa— y las dos cuentas ven los mismos tres clientes.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Todo lo del usuario cuelga de su uid, y sólo él lo toca.
    // El comodín `{document=**}` alcanza las subcolecciones —`declaraciones`,
    // `clientes`, y `clientes/*/empleados`— sin tener que enumerarlas: una
    // regla por subcolección es una regla que alguien olvida agregar.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Nada más es accesible. Sin esta negación explícita, una colección nueva
    // creada por error quedaría con el default del proyecto, que puede ser
    // permisivo si alguna vez estuvo en "modo de prueba".
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
