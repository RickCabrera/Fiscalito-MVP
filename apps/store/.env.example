VITE_FIREBASE_API_KEY=your-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456
VITE_FIREBASE_APP_ID=1:123456:web:abc123
VITE_FISCAL_AGENT_URL=http://localhost:8000
VITE_OPENAI_API_KEY=tu-api-key-de-openai

# O-01 · Modo empresa única. EL DEFAULT SE INVIRTIÓ EN T1.
# Sin la variable, la app arranca como el DESPACHO multi-cliente de las épicas
# E, G y R: cartera, selector de cliente activo y el Fiscalito de cada cliente.
# `1` la devuelve a la nómina de UNA empresa (sin cartera, sin lista de clientes
# y sin selector), que sigue entera y probada en el árbol.
#
# OJO: tu `.env` local gana sobre este default. Si viene de la corrida O con
# `VITE_MODO_EMPRESA_UNICA=1`, la app arranca en modo empresa aunque el código
# diga despacho — quítalo o ponlo en 0 para la demo de despacho.
VITE_MODO_EMPRESA_UNICA=0

# R-07 / T2 · Quién es el dueño de la cartera (clientes y empleados).
# Sin la variable, el CRUD entero va por Firestore desde el navegador, que es
# lo que la app ha hecho siempre. `1` lo manda al backend (`/api/v1/cartera/*`),
# que está construido y probado pero **exige credenciales de GCP**
# (`GOOGLE_APPLICATION_CREDENTIALS` o ADC) en `apps/api`: encenderlo sin ellas
# responde 503 a todo el CRUD. Compruébalo con
# `GET /api/v1/cartera/clientes` → 200 ANTES de encenderlo aquí.
# No hay migración de datos: las rutas de Firestore son las mismas de los dos
# lados, así que el interruptor se puede apagar igual de rápido.
VITE_CARTERA_BACKEND=0
