# SPA de Fiscalito (P6-03): mismas reglas de caché que firebase.json.
server {
    listen ${PORT};
    root /usr/share/nginx/html;

    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    location ~* \.(js|css|jpg|jpeg|gif|png|svg|webp|ico)$ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location = /salud {
        access_log off;
        return 200 "ok\n";
    }

    location / {
        try_files $uri /index.html;
    }
}
