# Fiscal Agent API - Environment Variables
# Copy this to .env and fill in your values

# LLM Provider: "openai" or "anthropic"
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# Anthropic
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Server
HOST=0.0.0.0
PORT=8000

# P0-02 — límites de la API (ver docs/api-contract.md)
# FISCALITO_RATE_LIMIT_POR_MINUTO=120
# FISCALITO_RATE_LIMIT_LLM_POR_MINUTO=20
# FISCALITO_TOPE_LLM_DIARIO_LLAMADAS=500
# Simulador del checador: token de dispositivo (POST /api/v1/asistencia/tokens) o ID token
# FISCALITO_TOKEN_DISPOSITIVO=
# FISCALITO_ID_TOKEN=
# levantar_demo.py: uid de Firebase del despacho dueño de las checadas sembradas
# FISCALITO_DESPACHO_DEMO=
