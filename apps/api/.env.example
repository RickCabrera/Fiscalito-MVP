# ─────────────────────────────────────────────────────────────────────────────
# Fiscal Agent API (Fiscalito) — variables de entorno
#
# Copia a `.env` y llena lo que uses. Las líneas comentadas (`# X=`) son opcionales o
# tienen default. `tests/test_env_example.py` falla si el código lee una variable que no
# está aquí. Detalle de cada servicio externo: docs/servicios-externos.md.
# Despliegue (Railway / docker compose): docs/despliegue.md.
# ─────────────────────────────────────────────────────────────────────────────

# ── Núcleo ───────────────────────────────────────────────────────────────────
# desarrollo | produccion. Con Postgres y sin esta variable se asume `produccion`
# (falla cerrado: sin implementaciones falsas, sin llave efímera, sin create_all).
FISCALITO_ENTORNO=desarrollo
# Railway inyecta la de su Postgres (postgres:// se convierte a postgresql+psycopg://).
# Sin ella: SQLite local ./fiscalito.db.
# DATABASE_URL=postgresql+psycopg://fiscalito:fiscalito@localhost:5432/fiscalito
HOST=0.0.0.0
PORT=8000
# Orígenes del front separados por coma (en producción, el dominio de la app; nunca *).
CORS_ORIGINS=http://localhost:5173
# Proyecto de Firebase cuyos ID tokens se aceptan (login).
FIREBASE_PROJECT_ID=fiscalito-mvp
# Contenedor (docker/arranque.sh): la API corre `alembic upgrade head` antes de arrancar y
# NO arranca si falla. 0 lo salta (p. ej. si las migraciones se corren aparte).
# FISCALITO_MIGRAR_AL_ARRANCAR=1
# SÓLO desarrollo con el emulador de Auth: acepta tokens sin verificar. Jamás en producción.
# PERMITIR_TOKEN_SIN_VERIFICAR=0

# ── Secretos propios (gestor de secretos de Railway) ─────────────────────────
# Llave(s) Fernet de la bóveda (e.firma, CSD) y de los datos bancarios cifrados (P6-01).
# La primera cifra; todas descifran. Generar:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# SI SE PIERDE, LO CIFRADO ES ILEGIBLE.
FISCALITO_LLAVE_MAESTRA=
# Firma HMAC de los enlaces públicos (recibos, documentos, exportaciones). Obligatoria en
# producción. Cualquier texto largo aleatorio.
FISCALITO_ENLACES_SECRETO=
# URL pública de esta API (enlaces que bajan WhatsApp y el dueño al exportar).
FISCALITO_URL_PUBLICA_API=http://localhost:8000
# URL del front (enlaces de los correos de invitación).
FISCALITO_URL_APP=http://localhost:5173

# ── Límites (P0-02) ──────────────────────────────────────────────────────────
# Hoy sólo `memoria` (un contador por proceso: con varias réplicas, el límite es por réplica).
# FISCALITO_LIMITADOR=memoria
# FISCALITO_RATE_LIMIT_POR_MINUTO=120
# FISCALITO_RATE_LIMIT_LLM_POR_MINUTO=20
# FISCALITO_TOPE_LLM_DIARIO_LLAMADAS=500

# ── Respaldos (P6-01) ────────────────────────────────────────────────────────
# Respaldo lógico diario de cada despacho al almacenamiento (03:30 hora de CDMX).
# FISCALITO_RESPALDOS_ACTIVOS=1
# FISCALITO_RESPALDOS_RETENCION_DIAS=30

# ── Adaptadores: cada uno se elige con FISCALITO_<SERVICIO> ──────────────────
# Sin la variable: `falso` fuera de producción; en producción, 503 en ese servicio.
# FISCALITO_ALMACENAMIENTO=falso        # falso | local | s3
# FISCALITO_CORREO=falso                # falso | smtp | resend | sendgrid
# FISCALITO_WHATSAPP=falso              # falso | meta | twilio
# FISCALITO_PAGOS=falso                 # falso | stripe | mercadopago
# FISCALITO_MONITOREO=falso             # falso | log | sentry
# FISCALITO_LLM=falso                   # falso | openai | anthropic
# FISCALITO_VOZ=falso                   # falso | openai
# FISCALITO_PAC=falso                   # falso | finkok | sw_sapien | facturama
# FISCALITO_SAT_DESCARGA=falso          # falso | sat
# FISCALITO_SAT_ESTATUS=falso           # falso | sat
# FISCALITO_SAT_LISTAS=falso            # falso | sat
# FISCALITO_OPINION_CUMPLIMIENTO=falso  # falso | portal_sat | proveedor | manual
# FISCALITO_BUZON_SAT=falso             # falso | portal_sat

# Almacenamiento local / S3 / R2
# FISCALITO_ALMACEN_DIR=./almacen
# FISCALITO_S3_BUCKET=
# FISCALITO_S3_PREFIJO=
# FISCALITO_S3_ENDPOINT=https://<cuenta>.r2.cloudflarestorage.com
# FISCALITO_S3_REGION=auto
# FISCALITO_S3_ACCESS_KEY=
# FISCALITO_S3_SECRET_KEY=

# Correo
# FISCALITO_CORREO_REMITENTE=Fiscalito <no-responder@tudominio.mx>
# FISCALITO_SMTP_HOST=
# FISCALITO_SMTP_PUERTO=587
# FISCALITO_SMTP_USUARIO=
# FISCALITO_SMTP_PASSWORD=
# FISCALITO_RESEND_API_KEY=
# FISCALITO_SENDGRID_API_KEY=

# WhatsApp (Meta Cloud API o Twilio) y bot
# FISCALITO_WHATSAPP_TOKEN=
# FISCALITO_WHATSAPP_PHONE_ID=
# FISCALITO_WHATSAPP_VERSION=v20.0
# FISCALITO_WHATSAPP_APP_SECRET=
# FISCALITO_WHATSAPP_VERIFY_TOKEN=
# FISCALITO_WHATSAPP_PLANTILLA_DOCUMENTOS=
# FISCALITO_WHATSAPP_BOT_POR_MINUTO=6
# FISCALITO_TWILIO_ACCOUNT_SID=
# FISCALITO_TWILIO_AUTH_TOKEN=
# FISCALITO_TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Pagos de suscripción (P5-08)
# FISCALITO_STRIPE_API_KEY=
# FISCALITO_STRIPE_WEBHOOK_SECRET=
# FISCALITO_MERCADOPAGO_ACCESS_TOKEN=
# FISCALITO_MERCADOPAGO_WEBHOOK_SECRET=
# FISCALITO_PAGOS_FALSO_SECRETO=
# Precio por plan (el id del plan en mayúsculas): FISCALITO_PLAN_<ID>_PRECIO y el id de
# precio del proveedor: FISCALITO_PAGOS_PRECIO_<ID>. Ejemplo:
# FISCALITO_PLAN_CONTADOR_PRECIO=
# FISCALITO_PAGOS_PRECIO_CONTADOR=
# FISCALITO_PLAN_MONEDA=MXN
# FISCALITO_PLANES_MODULOS={"contador": ["dispersion"]}
# FISCALITO_SUSCRIPCION_DIAS_PRUEBA=14
# FISCALITO_SUSCRIPCION_DIAS_GRACIA=3

# Monitoreo
# FISCALITO_SENTRY_DSN=

# LLM (sólo en el servidor; el front no tiene llaves)
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# PAC (timbrado y cancelación)
# FISCALITO_FINKOK_URL=
# FISCALITO_FINKOK_USUARIO=
# FISCALITO_FINKOK_PASSWORD=
# FISCALITO_SW_URL=
# FISCALITO_SW_USUARIO=
# FISCALITO_SW_PASSWORD=
# FISCALITO_SW_TOKEN=
# FISCALITO_FACTURAMA_URL=
# FISCALITO_FACTURAMA_USUARIO=
# FISCALITO_FACTURAMA_PASSWORD=

# SAT: descarga masiva, estatus de CFDI, listas 69-B
# FISCALITO_SAT_URL_AUTENTICACION=
# FISCALITO_SAT_URL_SOLICITUD=
# FISCALITO_SAT_URL_VERIFICACION=
# FISCALITO_SAT_URL_DESCARGA=
# FISCALITO_SAT_DIAS_MAX_ESPERA=7
# FISCALITO_SAT_HORAS_AVISO=24
# Sólo pruebas e2e (P6-04): primera verificación en segundos (default 120) y carpeta con
# los XML que entrega el SAT `falso` (<dir>/emitidos, <dir>/recibidos).
# FISCALITO_SAT_SEGUNDOS_PRIMERA_VERIFICACION=
# FISCALITO_SAT_FALSO_DIR=
# FISCALITO_SAT_ESTATUS_URL=
# FISCALITO_SAT_ESTATUS_POR_SEGUNDO=
# FISCALITO_SAT_ESTATUS_CONCURRENCIA=4
# FISCALITO_SAT_ESTATUS_LOTE=1000
# FISCALITO_SAT_LISTAS_ACTIVAS=69b
# URL por lista: FISCALITO_SAT_LISTA_<LISTA>_URL, p. ej.:
# FISCALITO_SAT_LISTA_69B_URL=

# Opinión de cumplimiento por proveedor (P1-05)
# FISCALITO_OPINION_PROVEEDOR_URL=
# FISCALITO_OPINION_PROVEEDOR_API_KEY=
# FISCALITO_OPINION_PROVEEDOR_ENCABEZADO=Authorization
# FISCALITO_OPINION_PROVEEDOR_METODO=GET
# FISCALITO_OPINION_PROVEEDOR_CAMPOS={}
# FISCALITO_OPINION_PROVEEDOR_RESULTADOS={}
# FISCALITO_OPINION_DIAS_VIGENCIA=30

# ── Scripts locales (no se usan en el servicio) ──────────────────────────────
# Simulador del checador: token de dispositivo (POST /api/v1/asistencia/tokens) o ID token
# FISCALITO_TOKEN_DISPOSITIVO=
# FISCALITO_ID_TOKEN=
# levantar_demo.py: uid de Firebase del despacho dueño de las checadas sembradas
# FISCALITO_DESPACHO_DEMO=
